<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Projetos que tocam APIs do Windows usam WindowsTfm; Host.Domain fica portável (brief D2). -->
    <PortableTfm>net10.0</PortableTfm>
    <WindowsTfm>net10.0-windows10.0.22621.0</WindowsTfm>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
</Project>
